# Disable directory browsing
Options -Indexes

# Block public browser access to .env, dotfiles, and raw CSV files
<FilesMatch "(^\.|\.csv$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
